# ─────────────────────────────────────────────────────────────────────────
# SARTA Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ─────────────────────────────────────────────────────────────────────────

# ── 1. MongoDB (Local or MongoDB Atlas Cloud) ───────────────────────────
# LOCAL OPTION:
# MONGO_URI=mongodb://127.0.0.1:27017
#
# CLOUD OPTION (MongoDB Atlas - Free M0 Tier):
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=sarta_db

# ── 2. Judge0 Sandbox (Local Docker or RapidAPI Cloud) ──────────────────
# LOCAL DOCKER OPTION (Default):
# JUDGE0_URL=http://127.0.0.1:2358
# JUDGE0_API_KEY=
# JUDGE0_API_HOST=
#
# CLOUD OPTION (Official Judge0 on RapidAPI):
# 1. Sign up on RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
# 2. Subscribe to the free Basic tier (~50 submissions/day)
# 3. Paste your RapidAPI key below:
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ── 3. SQLite Session Store ─────────────────────────────────────────────
# Local session storage for candidates during test progression
# SARTA_ASSESSMENT_DB=

# ── 4. FastAPI Server ───────────────────────────────────────────────────
SARTA_HOST=0.0.0.0
SARTA_PORT=8000
