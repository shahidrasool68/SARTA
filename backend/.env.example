# MongoDB Atlas Cloud Database Configuration
# Get your connection string from: https://cloud.mongodb.com/
# Cluster -> Connect -> Drivers -> Python
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/
MONGO_DB_NAME=sarta_db

# Judge0 Code Execution API (using free public Judge0 Community Edition cloud)
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Google Gemini API Key (100% Free tier)
# Get your free key instantly at: https://aistudio.google.com/app/apikey
# Powers dynamic on-the-fly calibrated question generation for any niche JD requirement
GEMINI_API_KEY=

# SARTA Assessment Session SQLite DB (for fallback session storage)
SARTA_ASSESSMENT_DB=assessment_sessions.sqlite3
