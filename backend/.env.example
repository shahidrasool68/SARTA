# ─────────────────────────────────────────────────────────────────────────
# SARTA Backend Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ─────────────────────────────────────────────────────────────────────────

# ── 1. MongoDB (Local or MongoDB Atlas Cloud) ───────────────────────────
# LOCAL OPTION:
# MONGO_URI=mongodb://127.0.0.1:27017
#
# CLOUD OPTION (MongoDB Atlas - Free M0 Tier):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=sarta_db

# ── 2. Judge0 Sandbox ───────────────────────────────────────────────────
# OPTION A (100% Free Public Cloud — No Key, No Card Needed):
# Official Judge0 public demo endpoint:
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# OPTION B (Local Docker):
# JUDGE0_URL=http://127.0.0.1:2358

# OPTION C (RapidAPI):
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key_here
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ── 3. SQLite Session Store ─────────────────────────────────────────────
# SARTA_ASSESSMENT_DB=

# ── 4. FastAPI Server ───────────────────────────────────────────────────
SARTA_HOST=0.0.0.0
SARTA_PORT=8000
